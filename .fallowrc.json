{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": ["src/index.{ts,tsx,js,jsx}", "src/main.{ts,tsx,js,jsx}"],
  "ignorePatterns": ["tools/**/*.ts"],
  "duplicates": {
    "minOccurrences": 2,
    "ignore": [],
    "near": true,
    "mode": "semantic"
  },
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error"
  }
}
