---
import PageLayout from '@/components/PageLayout.astro'
import GutterRow from '@/components/GutterRow.astro'
import BracketLink from '@/components/BracketLink.astro'
import { getCollection, render, type CollectionEntry } from 'astro:content'
import { formatDate } from '@/lib/format-date'
import { readingTime } from '@/lib/reading-time'

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.date.valueOf() - b.data.date.valueOf(),
  )

  return posts.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: posts[index - 1] ?? null,
      next: posts[index + 1] ?? null,
    },
  }))
}

type Props = {
  entry: CollectionEntry<'blog'>
  prev: CollectionEntry<'blog'> | null
  next: CollectionEntry<'blog'> | null
}

const { entry, prev, next } = Astro.props

const { Content } = await render(entry)

const minutes = readingTime(entry.body ?? '')

const frontmatterRows = [
  { label: 'date', value: formatDate(entry.data.date) },
  { label: 'tags', value: entry.data.tags.join(', ') },
  { label: 'reading', value: `${minutes} min read` },
]
---

<PageLayout title={entry.data.title} frontmatterRows={frontmatterRows}>
  <Content />
  <GutterRow mark="---">
    <hr />
  </GutterRow>
  <GutterRow mark="">
    <footer class="post-footer">
      <BracketLink href={`/blog/${entry.id}.md`}>view source</BracketLink>
      {prev && <BracketLink href={`/blog/${prev.id}`}>{prev.data.title}</BracketLink>}
      {next && <BracketLink href={`/blog/${next.id}`}>{next.data.title}</BracketLink>}
    </footer>
  </GutterRow>
</PageLayout>

<style>
  .post-footer {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
</style>
