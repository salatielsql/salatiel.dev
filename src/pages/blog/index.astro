---
import PageLayout from '@/components/PageLayout.astro'
import GutterRow from '@/components/GutterRow.astro'
import BlogListingRow from '@/components/BlogListingRow.astro'
import { getCollection } from 'astro:content'

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
)

const postsByYear = new Map<number, typeof posts>()

for (const post of posts) {
  const year = post.data.date.getUTCFullYear()
  const yearPosts = postsByYear.get(year) ?? []
  yearPosts.push(post)
  postsByYear.set(year, yearPosts)
}

const years = [...postsByYear.keys()].sort((a, b) => b - a)
---

<PageLayout title="Blog">
  <GutterRow mark="">
    <p>Writing about the parts of software that don't make it into the release notes.</p>
  </GutterRow>
  {
    years.map((year) => (
      <>
        <GutterRow mark="##" variant="heading">
          <h2>{year}</h2>
        </GutterRow>
        {postsByYear.get(year)!.map((post) => <BlogListingRow entry={post} />)}
      </>
    ))
  }
</PageLayout>
