---
import type { CollectionEntry } from 'astro:content'
import GutterRow from '@/components/GutterRow.astro'
import BracketLink from '@/components/BracketLink.astro'

type Props = {
  entry: CollectionEntry<'projects'>
}

const { entry } = Astro.props

const href = entry.data.url ?? entry.data.repo
---

<GutterRow mark="-">
  <article class="project-listing-row">
    <h3 class="project-listing-row__title">
      {href ? <BracketLink href={href}>{entry.data.title}</BracketLink> : entry.data.title}
      {entry.data.featured && <span class="project-listing-row__badge">featured</span>}
      {entry.data.archived && <span class="project-listing-row__badge">(archived)</span>}
    </h3>
    <p class="project-listing-row__description">{entry.data.description}</p>
    {entry.data.tags.length > 0 && <p class="project-listing-row__tags">{entry.data.tags.join(', ')}</p>}
  </article>
</GutterRow>

<style>
  .project-listing-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .project-listing-row__title {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    font-size: var(--font-size-h5);
  }

  .project-listing-row__badge {
    font-family: var(--font-mono);
    font-size: var(--font-size-small);
    color: var(--color-agent-context);
  }

  .project-listing-row__description {
    margin: 0;
    color: var(--color-body);
  }

  .project-listing-row__tags {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--font-size-small);
    color: var(--color-gutter-mark);
  }
</style>
