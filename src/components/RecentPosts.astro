---
import { getCollection } from 'astro:content'
import GutterRow from '@/components/GutterRow.astro'
import BlogListingRow from '@/components/BlogListingRow.astro'

type Props = {
  limit?: number
}

const { limit = 4 } = Astro.props

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, limit)
---

<GutterRow mark="##" variant="heading">
  <h2>Recent posts</h2>
</GutterRow>
{posts.map((post) => <BlogListingRow entry={post} />)}
