---
import '@/styles/global.css'
import { Font } from 'astro:assets'
import SiteHeader from '@/ui/SiteHeader.astro'
import SiteFooter from '@/ui/SiteFooter.astro'

type NavItem = {
  href: string
  label: string
  shortcut?: string
}

type Props = {
  title: string
  siteName: string
  section: string
  homeHref: string
  navItems?: NavItem[]
  copyright: string
  contactHref: string
  contactLabel: string
}


const { title, siteName, section, homeHref, navItems, copyright, contactHref, contactLabel  } = Astro.props
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" />
    <Font cssVariable="--font-jetbrains-mono" preload />
    <Font cssVariable="--font-instrument-sans" preload />
    <title>{title} — salatiel.dev</title>
  </head>
  <body>
    <div class="base-layout">
      <SiteHeader siteName={siteName} section={section} homeHref={homeHref} navItems={navItems} />

      <main class="base-layout__main"><slot /></main>

      <SiteFooter copyright={copyright} contactHref={contactHref} contactLabel={contactLabel} />
    </div>
  </body>
</html>

<style>
  .base-layout {
    min-height: 100vh;
    background: var(--ds-color-bg);
    color: var(--ds-color-text);
    font-family: var(--ds-font-body);
    -webkit-font-smoothing: antialiased;

    & .base-layout__main {
      max-width: var(--ds-content-max-width);
      margin: 0 auto;
      border-left: 1px solid var(--ds-color-border);
      border-right: 1px solid var(--ds-color-border);
      min-height: calc(100vh - 3.25rem);
    }
  }
</style>
