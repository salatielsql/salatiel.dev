---
type Props = {
  href: string
  date: string
  tag: string
  title: string
  blurb: string
}

const { href, date, tag, title, blurb } = Astro.props
---

<a href={href} class="post-list-item">
  <div class="post-list-item__meta">
    <time datetime={date}>{date}</time>
    <span class="post-list-item__dot">·</span>
    <span>{tag}</span>
  </div>
  <div class="post-list-item__title">{title}</div>
  <div class="post-list-item__blurb">{blurb}</div>
</a>

<style>
  .post-list-item {
    display: grid;
    gap: var(--ds-space-2);
    padding: var(--ds-space-8) var(--ds-space-6) var(--ds-space-8) 0;
    border-top: 1px solid var(--ds-color-border);
    color: var(--ds-color-text);
    text-decoration: none;
    transition: background var(--ds-transition-fast);

    &:hover {
      background: var(--ds-color-row-hover-bg);
    }

    & .post-list-item__meta {
      display: flex;
      align-items: center;
      gap: var(--ds-space-4);
      font-family: var(--ds-font-mono);
      font-size: 0.71875rem;
      color: var(--ds-color-text-faint);
    }

    & .post-list-item__dot {
      color: var(--ds-color-dot);
    }

    & .post-list-item__title {
      font-size: var(--ds-font-size-lg);
      font-weight: 600;
      letter-spacing: var(--ds-letter-spacing-tight);
      line-height: 1.3;
    }

    & .post-list-item__blurb {
      max-width: 60ch;
      font-size: var(--ds-font-size-base);
      line-height: var(--ds-line-height-body);
      color: var(--ds-color-text-muted);
    }
  }
</style>
