{
  "name": "salatiel.dev",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "typecheck": "tsc --noEmit",
    "format": "prettier . --write --ignore-unknown",
    "lint": "oxlint --format=agent",
    "lint:fix": "oxlint --fix",
    "quality:dead-code": "pnpm fallow dead-code --format compact",
    "quality:dupes": "pnpm fallow dupes",
    "quality:score": "pnpm fallow health",
    "quality:audit": "pnpm fallow audit --gate new-only",
    "check-code-quality": "pnpm run lint:fix || true && concurrently --group --prefix command -l 24 \"pnpm run lint\" \"pnpm run check\" \"pnpm run typecheck\" \"pnpm run quality:audit\"",
    "prepare": "husky"
  },
  "prettier": {
    "printWidth": 120,
    "jsxSingleQuote": false,
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true
  },
  "lint-staged": {
    "**/*": [
      "pnpm run format",
      "pnpm run check-code-quality"
    ]
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/mdx": "^7.0.5",
    "astro": "^7.2.2",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@oxlint/plugins": "1.83.0",
    "@types/hast": "^3.0.5",
    "concurrently": "^10.0.5",
    "fallow": "^3.25.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxlint": "^1.83.0",
    "prettier": "3.9.6",
    "typescript": "^5.9.3"
  }
}
